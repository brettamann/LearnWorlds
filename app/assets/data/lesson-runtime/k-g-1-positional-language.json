        },
        {
          "at": "we-try-correct-2",
          "text": "Behind the hollow tree."
        },
        {
          "at": "we-try-corrective-2",
          "text": "Behind the hollow tree — try the spot on the far side of the tree."
        },
        {
          "at": "we-try-closing",
