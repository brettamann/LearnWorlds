# Auto-installed deps for tooling scripts.
tools/scripts/node_modules/

# Tool outputs (regenerated; not source-of-truth).
tools/tts/harvest-manifest.json
tools/tts/canonical-manifest.json
tools/tts/render-plan.json
tools/tts/voice-samples/
tools/tts/preview-bundle/

# Rendered audio and Stage 5 manifests are generated by the TTS pipeline,
# not source-of-truth. Audio files are large; manifests are derivable from
# the canonical manifest + a real render pass. Exclude both.
assets/narration-manifest.json
assets/**/narration/**/manifest.json
assets/**/*.mp3
assets/**/*.m4a
assets/**/*.hash

# Editor / OS cruft.
.DS_Store
Thumbs.db
*.swp
*.swo

# Flutter — see app/.gitignore for the comprehensive list.
app/.dart_tool/
app/build/

# Personal scratch notes (excluded by default; remove this line if you want them tracked).
human-notes*.txt

# Secrets. app/.env holds the ImageGeneration service credentials; it must never
# be committed. Patterns are broad on purpose - a key that reaches the index is
# a key that has to be rotated.
.env
.env.*
!.env.example
*.key
*-key.txt

# Art pipeline. The finished sprites are committed under app/assets/; these are
# the working files behind them. The cached originals are large and always
# reproducible from the manifest, so only the manifest is tracked - it carries
# the provenance and the running cost, and Cache.get() checks that the file is
# actually present before claiming a hit.
tools/artgen/out/
tools/artgen/cache/*.png

# Kokoro narration renderer. node_modules is ~450MB (onnxruntime + the ONNX
# model cache); the auditions are scratch takes for picking a voice by ear.
# The rendered clips themselves ARE committed - see tools/tts/kokoro/README.md
# for why - and script.json / rendered.json are the provenance for them.
tools/tts/kokoro/node_modules/
tools/tts/kokoro/audition/

# Tool build caches
tools/tts/.dart_tool/
__pycache__/
